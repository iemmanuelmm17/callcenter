{
  "name": "callscope-reporting",
  "version": "2.0.0",
  "private": true,
  "description": "CallScope reporting dashboard (PHP endpoints + React front end). package.json is DEV-ONLY: it builds assets/js/app.js and assets/css/app.css from the sources under assets/*/src and runs the test harness. The deployed application is still plain PHP + static assets.",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:js": "node tools/build.mjs --js",
    "build:css": "node tools/build.mjs --css",
    "test": "node tests/run.mjs",
    "test:js": "node tests/run.mjs js",
    "test:php": "node tests/run.mjs php",
    "lint:php": "node tools/php-lint.mjs",
    "build:prod": "node tools/build.mjs --prod",
    "deploy:check": "node tools/deploy-check.mjs"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fortawesome/fontawesome-free": "6.5.2",
    "@tailwindcss/cli": "^4.1.14",
    "acorn": "^8.19.0",
    "chart.js": "4.4.7",
    "esbuild": "^0.25.10",
    "fflate": "^0.8.3",
    "jsdom": "^27.0.0",
    "php-parser": "^3.2.5",
    "php-wasm": "^0.2.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tabulator-tables": "6.3.1",
    "tailwindcss": "^4.1.14"
  },
  "engines": {
    "node": ">=20"
  }
}
