# ---------------------------------------------------------------------------
# Never commit runtime state: these directories hold caller records, tenant
# domains, PBX cache payloads and audit trails.
# ---------------------------------------------------------------------------
/cache/
/logs/
*.log
*.jsonl

# ---------------------------------------------------------------------------
# Dev build output (QA-4). The deploy artifacts are the content-hashed files
# named by assets/build-manifest.json; these unversioned copies are what
# `node tools/build.mjs` produces locally and what the jsdom harness mounts.
# ---------------------------------------------------------------------------
/assets/js/app.js
/assets/css/app.css

# ---------------------------------------------------------------------------
# Local configuration and secrets. Deployment values live in the environment
# (PBX_SERVERS, PBX_CLIENT_ID, PBX_CLIENT_SECRET, PBX_SIP_TOKEN, ...) or in
# includes/config.local.php, which must stay on the server.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example
/includes/config.local.php

# ---------------------------------------------------------------------------
# Tooling / editor noise
# ---------------------------------------------------------------------------
/node_modules/
.DS_Store
Thumbs.db
*.swp
# Test scratch space (see tests/php/php.mjs)
/tests/.tmp/
